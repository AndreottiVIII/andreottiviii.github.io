<ol>
  {%- for it in f.shown %}
  <li{% if it.dev %} data-dev-for="{{ it.dev }}"{% endif %}><i>{{ it.n }}</i><a href="{{ it.url }}">{{ it.title }}</a>{% if it.lang == 'it' %} <span class="it">IT</span>{% endif %}</li>
  {%- endfor %}
  {%- if f.pegN %}
  <li class="peg"><i>{{ f.pegN }}</i>On the pegboard: {% for p in f.pegItems %}<a href="{{ p.url }}">{{ p.title }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% if f.more %} and <a href="{{ f.url }}">{{ f.more }} more →</a>{% endif %}</li>
  {%- elif f.more %}
  <li class="more"><a href="{{ f.url }}">and {{ f.more }} more →</a></li>
  {%- endif %}
  {%- if f.deskN %}
  <li class="peg"><i>{{ f.deskN }}</i>On the desk, the latest: {% for p in f.desk %}<a href="{{ p.url }}">{{ p.deskTitle }}</a>{% if not loop.last %}, {% endif %}{% endfor %} · <a href="/post">every sheet, newest first →</a></li>
  {%- endif %}
  {%- if f.key == 'writing' %}
  <li class="more idx-li"><a href="/blog-index">The index of every sheet in the house →</a></li>
  {%- endif %}
  {%- if not f.count %}
  <li class="empty">Nothing here yet.</li>
  {%- endif %}
  {%- if withLetters %}
  <li class="lt-li"><i>L</i><a href="{{ letters.url }}" target="_blank" rel="noopener">{{ letters.label }}, on Substack ↗</a>{% if letters.latest %}<span class="ph">{{ letters.latest }}</span>{% endif %}</li>
  {%- for a in letters.also %}
  <li class="lt-li"><i>{{ a.key }}</i><a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.label }}, on Substack ↗</a>{% if a.lang == 'it' %} <span class="it">IT</span>{% endif %}</li>
  {%- endfor %}
  {%- endif %}
</ol>
