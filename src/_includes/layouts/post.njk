---
layout: layouts/base.njk
---
{%- set body = content -%}
{%- if duplicate_of -%}
  {%- set orig = collections.posts | findUrl(duplicate_of + '.html') -%}
  {%- set body = orig.templateContent -%}
{%- endif -%}
{%- set fk = floor if floor else 'writing' -%}
{%- set F = collections.house.byKey[fk] -%}
{%- set me = duplicate_of if duplicate_of else (page.url | cleanUrl) -%}
{%- set sh = F | sheetIn(me) -%}
{%- set roomName = F.room -%}
{%- set mhFloor = fk -%}
<div class="wrap">
  <div class="ph-top">{% include "mini-house.njk" %}<b>{{ roomName | upper }}</b><a href="{{ F.url }}">← {{ F.name }}</a></div>
  <div class="sheetpost">
    <aside class="cart" aria-label="About this sheet">
      <a class="back room" href="{{ F.url }}">{% include "mini-house.njk" %}<span><b>{{ roomName }}</b><br><span class="k" style="margin:0">← back to {{ F.name }}</span></span></a>
      <div><span class="k">date</span><span class="v">{{ page.date | dateLong }}</span></div>
      <div><span class="k">{% if author %}written by{% else %}drawn by{% endif %}</span><span class="v">{{ author or 'Davide Caniatti' }}</span></div>
      {%- if sh.i >= 0 %}
      <div><span class="k">sheet</span><span class="v">{{ sh.i + 1 }} of {{ sh.n }} in the {{ roomName | lower }}</span></div>
      {%- endif %}
      {%- if categories %}
      <div><span class="k">category</span><div class="plates">{% for c in categories %}<a href="{{ c | categoryUrl }}">{{ c }}</a>{% endfor %}</div></div>
      {%- endif %}
      {%- if labels %}
      <div><span class="k">tags</span><div class="plates">{% for t in labels %}<a href="{{ t | tagUrl }}" rel="tag">{{ t }}</a>{% endfor %}</div></div>
      {%- endif %}
    </aside>
    <article class="post h-entry">
      <div class="title mono"><span>{{ roomName | upper }} · {{ F.name | upper }}</span><span>{{ page.date | dateDots }}</span></div>
      <h1 class="ttl entry-title">{{ title }}</h1>
      <div class="ph-meta"><span><time class="dt-published" datetime="{{ page.date | dateISO }}">{{ page.date | dateMD }} {{ page.date.getUTCFullYear() }}</time>{% if author %} · {{ author | upper }}{% endif %}</span>{% if sh.i >= 0 %}<span>{{ sh.i + 1 }} / {{ sh.n }}</span>{% endif %}</div>
      <div class="pb post-body e-content">
{{ body | safe }}
      </div>
      {%- if categories or labels %}
      <footer class="endtags">
        {%- if categories %}<p class="k">CATEGORY</p><div class="plates">{% for c in categories %}<a href="{{ c | categoryUrl }}">{{ c }}</a>{% endfor %}</div>{% endif %}
        {%- if labels %}<p class="k">TAGS</p><div class="plates">{% for t in labels %}<a href="{{ t | tagUrl }}" rel="tag">{{ t }}</a>{% endfor %}</div>{% endif %}
      </footer>
      {%- endif %}
      <nav class="stairs" aria-label="Other sheets in the {{ roomName | lower }}">
        {%- if sh.newer %}<a class="up" href="{{ sh.newer.url }}"><span class="lbl">↑ newer in the {{ roomName | lower }}</span>{{ sh.newer.title }}</a>{% else %}<a class="up" href="{{ F.url }}"><span class="lbl">↑ up</span>{{ F.name }}</a>{% endif %}
        <a class="whole" href="/">The whole house</a>
        {%- if sh.older %}<a class="down" href="{{ sh.older.url }}"><span class="lbl">↓ older in the {{ roomName | lower }}</span>{{ sh.older.title }}</a>{% else %}<a class="down" href="{{ F.url }}"><span class="lbl">↓ down</span>{{ F.name }}</a>{% endif %}
      </nav>
    </article>
  </div>
</div>
