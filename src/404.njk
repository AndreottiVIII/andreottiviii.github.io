{%- set mhFloor = "none" -%}
<div class="wrap nf">
  <div class="title mono"><span>SHEET NOT FOUND</span><span>404</span></div>
  <div class="nf-body">
    {% include "mini-house.njk" %}
    <div>
      <h1>This room is not in the house</h1>
      <p>Page not found: it does not exist (any more). Try one of the floors:</p>
      <ul class="plates">
        {%- for f in floors %}<li><a href="{{ f.url }}">{{ f.name }}</a></li>{% endfor %}
        <li><a href="/">The whole house</a></li>
      </ul>
    </div>
  </div>
</div>
