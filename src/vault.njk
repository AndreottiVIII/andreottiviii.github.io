---
layout: layouts/base.njk
house: true
permalink: /vault.html
eleventyExcludeFromCollections: true
noindex: true
bodyClass: dark-room
floor: photography
eleventyComputed:
  title: "{{ vault.label }}"
  description: "{{ vault.blurb }}"
---
{#- Il vault: pagina fuori da Google (noindex, non in sitemap). Il contenuto e' cifrato in /vault-box/ e si apre nel browser con la combinazione (assets/js/vault.js). Gli originali non stanno mai nel repository: li cifra tools/vault_build.py -#}
<div class="wrap gal vault">
  <div class="title mono"><span>CELLAR · THE VAULT</span><span>COMBINATION REQUIRED</span></div>
  <header class="fl-head">
    <div class="h"><b>Cellar</b><a href="/photography">← back to the darkroom</a></div>
    <h1>{{ vault.label }}</h1>
    <p class="blurb">{{ vault.blurb }}</p>
  </header>
  <form class="vt-door" id="vt-form" autocomplete="off">
    <svg class="vt-safe" viewBox="0 0 120 104" aria-hidden="true"><rect x="2" y="2" width="116" height="96" fill="none" stroke="currentColor" stroke-width="2"/><rect x="12" y="12" width="96" height="76" fill="none" stroke="currentColor" stroke-width="1.2"/><circle cx="56" cy="50" r="20" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="56" cy="50" r="3" fill="currentColor"/><path d="M56 26v6M56 68v6M32 50h6M74 50h6M39 33l4 4M69 63l4 4M73 33l-4 4M43 63l-4 4" stroke="currentColor" stroke-width="1.2"/><path d="M94 36v28" stroke="currentColor" stroke-width="3"/><path d="M14 98v4M106 98v4" stroke="currentColor" stroke-width="2"/></svg>
    <div class="vt-lock">
      <label for="vt-pw" class="mono">Combination</label>
      <div class="vt-row"><input id="vt-pw" name="combination" type="password" required spellcheck="false"><button type="submit">Open</button></div>
      <p class="vt-msg mono" role="status" aria-live="polite"></p>
    </div>
  </form>
  <div id="vt-inside" hidden></div>
  <nav class="stairs" aria-label="Other floors">
    <a class="up" href="/photography"><span class="lbl">↑ up</span>Photography</a>
    <a class="whole" href="/">The whole house</a>
  </nav>
</div>
<script src="/assets/js/vault.js" defer></script>
